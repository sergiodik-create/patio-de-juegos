// Configuración para publicar en Cloudflare Workers (recursos estáticos).
// Cloudflare ejecuta «python3 build.py» y después «npx wrangler deploy», que sube la carpeta dist/web.
// La web se sirve en patiodejuegos.app (dominio añadido en el panel, pestaña Domains del Worker).
// workers_dev y preview_urls en false: apaga las direcciones *.workers.dev, que wrangler volvería a encender en cada publicación.
{
  "name": "patio-de-juegos",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web"
  }
}
